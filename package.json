{
  "name": "xmas-cli",
  "version": "0.2.0",
  "description": "A winter wrapper for Claude Code and Codex: snow, lights and a Santa hat around the real CLIs",
  "keywords": [
    "claude-code",
    "codex",
    "cli",
    "terminal",
    "pty",
    "christmas"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "xmas": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^26.6.6",
    "prettier": "^3.8.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
